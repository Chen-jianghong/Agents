{
  "name": "multi-agent-dev-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node examples/e2e-real-provider.mjs",
    "dev-server": "node examples/dev-server.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:desktop": "npm run build && npm run build:electron && npm run build:renderer",
    "desktop:dev": "npm run build:desktop && electron apps/desktop/dist-electron/main.js",
    "dist:desktop": "npm run build:desktop && electron-builder --win"
  },
  "main": "apps/desktop/dist-electron/main.js",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "typebox": "1.3.7",
    "ws": "^8.21.1"
  }
}
